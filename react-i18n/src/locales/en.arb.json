{
  "@@locale": "en",
  "app_title": "React ARB i18n Engine",
  "@app_title": {
    "description": "The title of the application"
  },
  "hello": "Hello {name}!",
  "@hello": {
    "description": "Greeting message with a name",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "John"
      }
    }
  },
  "items_count": "{count, plural, =0 {You have no items} =1 {You have 1 item} other {You have {count} items}}",
  "@items_count": {
    "description": "Number of items in the cart",
    "placeholders": {
      "count": {
        "type": "num",
        "format": "compact"
      }
    }
  },
  "price_tag": "Total price: {amount, number, currency}",
  "@price_tag": {
    "description": "Formatted price tag",
    "placeholders": {
      "amount": {
        "type": "double"
      }
    }
  },
  "date_today": "Today is {date}",
  "@date_today": {
    "description": "Current date representation",
    "placeholders": {
      "date": {
        "type": "DateTime"
      }
    }
  },
  "fallback_demo": "This message is a fallback from English!",
  "@fallback_demo": {
    "description": "A demo message that only exists in English to show fallback capability"
  }
}
